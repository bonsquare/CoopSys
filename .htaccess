# Only needed on shared hosting when the web root CANNOT point to /public.
# Sends every request into the public folder and blocks sensitive files.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(\.env|composer\.(json|lock)|artisan)$ - [F,L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
